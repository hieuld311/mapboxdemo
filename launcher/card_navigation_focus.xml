<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationFocusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Live map preview, full-bleed background. Bound from item.naviMapSnapshot;
         stays empty (transparent) until the app pushes the first snapshot. Kept as a fallback
         layer beneath navFocusMapSurface (nav app not running / below API 32). -->
    <ImageView
        android:id="@+id/navFocusMapImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Live, smoothly-rendering map surface (API 32+), embedded from the nav app's
         MapWidgetSurfaceService via SurfaceControlViewHost. Read-only: no touch is wired to
         it, so gestures pass through to the card's own click handling. Bound/released from
         HomeCardViewHolder via HomeCardMapSurfaceController. -->
    <SurfaceView
        android:id="@+id/navFocusMapSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- Default state: shown when navigation is not active -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navFocusDefaultView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navFocusDefaultIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ico_launcher_list_app_nav_extend"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/navFocusDefaultText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/navFocusDefaultText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:text="Ready to go!\nPick a destination to start your journey."
            android:textColor="#D1FFFD"
            android:textSize="16sp"
            android:gravity="center"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navFocusDefaultIcon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- TBT state: shown when navigation is active. Floats over the map instead of
         covering the whole card, so the snapshot behind it stays visible. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navFocusTbtView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:background="@drawable/bg_area_focused"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/navFocusTurnIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/navFocusDirection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#D1FFFD"
            android:textSize="16sp"
            android:includeFontPadding="false"
            app:layout_constraintTop_toTopOf="@id/navFocusTurnIcon"
            app:layout_constraintStart_toEndOf="@id/navFocusTurnIcon"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/navFocusDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#D1FFFD"
            android:textSize="36sp"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navFocusDirection"
            app:layout_constraintStart_toEndOf="@id/navFocusTurnIcon"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/navFocusRoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D1FFFD"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navFocusTurnIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/navFocusDestination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D1FFFD"
            android:textSize="12sp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/navFocusRoad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>