android_library_import {
    name: "apng_2.28.0",
    aars: ["libs/apng-2.28.0.aar"],
    sdk_version: "current"
}

android_library_import {
    name: "frameanimation_2.28.0",
    aars: ["libs/frameanimation-2.28.0.aar"],
    sdk_version: "current"
}

android_library_import {
    name: "jna-5.13.0",
    aars: ["libs/jna-5.13.0.aar"],
    sdk_version: "current"
}

android_library_import {
    name: "realtimeblurview-f54dc3c34d",
    aars: ["libs/realtimeblurview-f54dc3c34d.aar"],
    sdk_version: "current"
}

java_import {
    name: "gson-2.11.0",
    jars: ["libs/gson-2.11.0.jar"],
    sdk_version: "current"
}

filegroup {
    name: "fauto.car.aidl",
    srcs: [
        "src/aidl/**/*.aidl",
    ],
}

java_library {
    name: "fauto_aidl",
    installable: false,
    aidl : {
        local_include_dirs : ["src/aidl"]
    },
    srcs : [
        ":fauto.car.aidl"
    ],
    system_ext_specific: true,
}

android_app {
    name: "FAutoLauncher",

    srcs: [
        "src/**/*.java",
    ],

    resource_dirs: ["res"],

    platform_apis: true,

    required: ["privapp_whitelist_com.ivi.launcher"],

    certificate: "platform",

    privileged: true,

    overrides: [
        "Launcher2",
        "Launcher3",
        "Launcher3QuickStep",
        "CarLauncher"
    ],

    optimize: {
        enabled: false,
    },

    dex_preopt: {
        enabled: false,
    },

    static_libs: [
        "androidx-constraintlayout_constraintlayout-solver",
        "androidx-constraintlayout_constraintlayout",
        "androidx.lifecycle_lifecycle-extensions",
        "car-media-common",
        "car-ui-lib",
        "com.google.android.material_material",
	    "SystemUISharedLib",
	    "WindowManager-Shell",
	    "car-telephony-common",
        "apng_2.28.0",
        "frameanimation_2.28.0",
        "jna-5.13.0",
        "realtimeblurview-f54dc3c34d",
        "gson-2.11.0",
        "fauto_aidl",
        "IVISecondaryLauncherLib",
    ],

    libs: ["android.car"],

    product_variables: {
        pdk: {
            enabled: false,
        },
    },
}
