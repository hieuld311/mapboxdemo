<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationCompactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Idle state: navigation not active -->
    <LinearLayout
        android:id="@+id/navCompactIdleView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navCompactIdleIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ico_launcher_list_app_nav_extend"
            android:scaleType="centerInside"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/navCompactIdleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Navigation"
            android:textColor="#D1FFFD"
            android:textSize="14sp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Active state: navigation running -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navCompactTbtView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Turn icon -->
        <ImageView
            android:id="@+id/navCompactTurnIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            android:background="@drawable/bg_navi_turn_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Step distance (large, teal) -->
        <TextView
            android:id="@+id/navCompactDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#00F9EC"
            android:textSize="32sp"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="@id/navCompactTurnIcon"
            app:layout_constraintStart_toEndOf="@id/navCompactTurnIcon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Road name -->
        <TextView
            android:id="@+id/navCompactRoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textColor="#D1FFFD"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navCompactDistance"
            app:layout_constraintStart_toEndOf="@id/navCompactTurnIcon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Route progress bar -->
        <ProgressBar
            android:id="@+id/navCompactProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:progressDrawable="@drawable/bg_home_media_focus_progress"
            android:max="1000"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintTop_toBottomOf="@id/navCompactTurnIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom: remaining distance (left) + ETA (right) -->
        <TextView
            android:id="@+id/navCompactRemainingDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D1FFFD"
            android:textSize="14sp"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navCompactProgressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/navCompactEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D1FFFD"
            android:textSize="14sp"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navCompactProgressBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>