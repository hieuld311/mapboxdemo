<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationFocusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Periodic map snapshot (refreshed ~every 3s from the app via MapSnapshotter, see
         HomeCardViewHolder/HomeNaviDataProvider). Bottom-most layer, GONE until a snapshot has
         actually arrived and the focus-grow animation (if any) has settled. -->
    <ImageView
        android:id="@+id/navFocusMapImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Default state: shown when navigation is not active -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navFocusDefaultView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navFocusDefaultIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ico_launcher_list_app_nav_extend"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/navFocusDefaultText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/navFocusDefaultText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:text="Ready to go!\nPick a destination to start your journey."
            android:textColor="#D1FFFD"
            android:textSize="16sp"
            android:gravity="center"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/navFocusDefaultIcon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>