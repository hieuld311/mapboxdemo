<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent cyan panel wrapping navFocusTbtView (card_navigation_focus.xml) - keeps the
     existing light text legible over the map image while giving the TBT panel a visible
     boundary, matching the app's cyan accent (#00F9EC) used elsewhere for nav UI. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3300F9EC" />
    <corners android:radius="20dp" />
    <stroke
        android:width="2dp"
        android:color="#00F9EC" />
</shape>
