<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navigation_dialog"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_pill"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/closeDialog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close search"
            android:gravity="center"
            android:text="‹"
            android:textColor="#0F172A"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/destinationInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search destination"
            android:imeOptions="actionGo"
            android:inputType="textPostalAddress"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/setRoute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Navigate"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#0F172A"
            android:textSize="22sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/categoryRestaurant"
                style="@style/NavigationCategoryChip"
                android:text="Restaurant" />

            <TextView
                android:id="@+id/categoryHotel"
                style="@style/NavigationCategoryChip"
                android:text="Hotel" />

            <TextView
                android:id="@+id/categoryHospital"
                style="@style/NavigationCategoryChip"
                android:text="Hospital" />

            <TextView
                android:id="@+id/categoryGasStation"
                style="@style/NavigationCategoryChip"
                android:text="Gas" />

            <TextView
                android:id="@+id/categoryConvenience"
                style="@style/NavigationCategoryChip"
                android:text="Convenience" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navigateHome"
            style="@style/NavigationCompactButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Navigate Home" />

        <Button
            android:id="@+id/navigateWork"
            style="@style/NavigationCompactButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Navigate Work" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/setMapCenterHome"
            style="@style/NavigationCompactButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Set Home" />

        <Button
            android:id="@+id/setMapCenterWork"
            style="@style/NavigationCompactButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Set Work" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/useMapCenter"
            style="@style/NavigationCompactButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Use map center as demo origin" />

        <Button
            android:id="@+id/clearHome"
            style="@style/NavigationIconButton"
            android:layout_marginStart="4dp"
            android:contentDescription="Clear Home"
            android:text="H×" />

        <Button
            android:id="@+id/clearWork"
            style="@style/NavigationIconButton"
            android:layout_marginStart="4dp"
            android:contentDescription="Clear Work"
            android:text="W×" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navigationState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="IDLE"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/searchProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#475569"
        android:textSize="11sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/suggestionScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/suggestionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/placeDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_place_detail"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/placeDetailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/closePlaceDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Close place detail"
                android:gravity="center"
                android:text="×"
                android:textColor="#334155"
                android:textSize="22sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/placeDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:contentDescription="Place photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/placeDetailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#334155"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/placeDetailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/placeDirections"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="#2563EB"
            android:text="Directions"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
